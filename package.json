{
  "name": "valida",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "serve": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:conformance": "bunx --bun vitest run --config conformance/vitest.config.ts",
    "smoke": "bun scripts/smoke.ts",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.sqlite.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.pg.config.ts"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint": "^1.2.0",
    "@langchain/langgraph-sdk": "^1.12.3",
    "@langchain/protocol": "^0.0.19",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "bullmq": "^5.81.5",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@langchain/langgraph-checkpoint-validation": "1.2.0",
    "@libsql/client": "^0.18.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
