{
  "name": "aegra-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "serve": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ui:dev": "bun --cwd ui dev",
    "ui:build": "bun --cwd ui build"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-sdk": "^1.0.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.0.0",
    "ioredis": "^5.0.0",
    "postgres": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.0.0"
  }
}
